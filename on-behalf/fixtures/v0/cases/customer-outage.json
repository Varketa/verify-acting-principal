{
  "name": "customer-outage",
  "description": "A 503 at hop 2 drops nothing; the retry presents a fresh subject and keeps hop 1.",
  "steps": [
    {
      "do": "credential",
      "customer": "sess_a",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/login/token-exchange",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "$assertion",
              "subject_token_type": "urn:ietf:params:oauth:token-type:jwt"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 200,
            "body": {
              "access_token": "actor-1",
              "token_type": "DPoP",
              "expires_in": 300
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/login/token-exchange",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "$subject",
              "subject_token_type": "urn:ietf:params:oauth:token-type:jwt",
              "actor_token": "actor-1",
              "actor_token_type": "urn:ietf:params:oauth:token-type:access_token"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 503,
            "body": {
              "error": "temporarily_unavailable"
            }
          }
        }
      ],
      "expect": {
        "accept": false,
        "error": {
          "step": "customer",
          "status": 503,
          "code": "temporarily_unavailable",
          "description": null
        },
        "disposition": {
          "drop_actor": false,
          "drop_customer": false
        }
      }
    },
    {
      "do": "credential",
      "customer": "sess_a",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/login/token-exchange",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "$subject",
              "subject_token_type": "urn:ietf:params:oauth:token-type:jwt",
              "actor_token": "actor-1",
              "actor_token_type": "urn:ietf:params:oauth:token-type:access_token"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 200,
            "body": {
              "access_token": "customer-2",
              "token_type": "DPoP",
              "expires_in": 300
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/oauth/token",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "customer-2",
              "subject_token_type": "urn:ietf:params:oauth:token-type:access_token",
              "resource": "https://tenant.varketa.example/mcp"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 200,
            "body": {
              "access_token": "door-2",
              "token_type": "DPoP",
              "expires_in": 300
            }
          }
        }
      ],
      "expect": {
        "accept": true,
        "access_token": "door-2"
      }
    }
  ]
}
