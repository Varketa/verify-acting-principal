{
  "name": "actor-refused",
  "description": "Hop 2's actor_token_not_usable drops the backend's session.",
  "steps": [
    {
      "do": "credential",
      "customer": "sess_a",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/login/token-exchange",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "$assertion",
              "subject_token_type": "urn:ietf:params:oauth:token-type:jwt"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 200,
            "body": {
              "access_token": "actor-1",
              "token_type": "DPoP",
              "expires_in": 300
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/login/token-exchange",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "$subject",
              "subject_token_type": "urn:ietf:params:oauth:token-type:jwt",
              "actor_token": "actor-1",
              "actor_token_type": "urn:ietf:params:oauth:token-type:access_token"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 400,
            "body": {
              "error": "invalid_grant",
              "error_description": "actor_token_not_usable"
            }
          }
        }
      ],
      "expect": {
        "accept": false,
        "error": {
          "step": "customer",
          "status": 400,
          "code": "invalid_grant",
          "description": "actor_token_not_usable"
        },
        "disposition": {
          "drop_actor": true,
          "drop_customer": true
        }
      }
    },
    {
      "do": "credential",
      "customer": "sess_a",
      "exchanges": [
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/login/token-exchange",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "$assertion",
              "subject_token_type": "urn:ietf:params:oauth:token-type:jwt"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 200,
            "body": {
              "access_token": "actor-2",
              "token_type": "DPoP",
              "expires_in": 300
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/login/token-exchange",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "$subject",
              "subject_token_type": "urn:ietf:params:oauth:token-type:jwt",
              "actor_token": "actor-2",
              "actor_token_type": "urn:ietf:params:oauth:token-type:access_token"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 200,
            "body": {
              "access_token": "customer-2",
              "token_type": "DPoP",
              "expires_in": 300
            }
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "https://varketa.example/oauth/token",
            "form": {
              "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
              "subject_token": "customer-2",
              "subject_token_type": "urn:ietf:params:oauth:token-type:access_token",
              "resource": "https://tenant.varketa.example/mcp"
            },
            "dpop": {
              "nonce": null,
              "ath": false
            }
          },
          "response": {
            "status": 200,
            "body": {
              "access_token": "door-2",
              "token_type": "DPoP",
              "expires_in": 300
            }
          }
        }
      ],
      "expect": {
        "accept": true,
        "access_token": "door-2"
      }
    }
  ]
}
